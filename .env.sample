# ── Application ──
TEMPLATE_APP_NAME=Graphics Service
TEMPLATE_APP_VERSION=0.1.0
TEMPLATE_APP_HOST=0.0.0.0
TEMPLATE_APP_PORT=8000
TEMPLATE_APP_DEBUG=true

# ── Database (PostgreSQL — shared with main-be) ──
# Local: localhost:5432, Docker: graphics_postgres:5432
DATABASE_DSN=postgresql+asyncpg://nexoradev:nexoradev@localhost:5432/nexoradev

# ── Redis ──
# Local: localhost, Docker: redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── NATS ──
# Local: localhost:4222, Docker: nats:4222
NATS_HOSTS=nats://localhost:4222
NATS_STREAM_NAME=graphics
NATS_SUBJECT=graphics.>
NATS_CONSUMER_DURABLE=graphics-service-consumer

# ── Auth (mock for now) ──
AUTH_SECRET_KEY=supersecret
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Sentry (disabled by default) ──
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
